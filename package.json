{
  "name": "oryntaa-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:content": "tsx scripts/check-content.ts",
    "check:assets": "node scripts/check-assets.mjs",
    "check:arbitrary": "node scripts/check-arbitrary.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:content && pnpm run check:assets && pnpm run check:arbitrary",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@marsidev/react-turnstile": "1.5.3",
    "@radix-ui/react-accordion": "1.2.15",
    "@radix-ui/react-dialog": "1.1.18",
    "@radix-ui/react-dropdown-menu": "2.1.19",
    "@react-email/components": "1.0.12",
    "@supabase/supabase-js": "2.110.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gray-matter": "4.0.3",
    "lucide-react": "1.23.0",
    "motion": "12.42.2",
    "next": "15.5.20",
    "next-mdx-remote": "6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.81.0",
    "reading-time": "1.5.0",
    "resend": "6.17.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.20",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10"
  }
}
