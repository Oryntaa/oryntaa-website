# Oryntaa environment contract — copy to .env.local and fill from the team password manager.
# Every variable is declared and Zod-validated in src/lib/env.ts (ENVIRONMENT_VARIABLES).
# Update this file in the same PR as any env change. Never commit real secrets.

# --- Server (never exposed to the client bundle) ---
# Supabase project (dev vs prod per environment). Service-role key is highest-sensitivity.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Resend API key (must start with re_) + lead notification recipient.
RESEND_API_KEY="re_your_api_key"
LEADS_INBOX="hello@oryntaa.com"
# Cloudflare Turnstile secret (CI uses the Cloudflare always-pass test secret).
TURNSTILE_SECRET_KEY="your-turnstile-secret"
# Random salt (>=16 chars) for hashing lead IPs; rotating it makes old hashes unmatchable.
LEAD_IP_SALT="change-me-min-16-chars"

# --- Client (NEXT_PUBLIC_*, safe to ship in the bundle) ---
# Canonical site URL: https://oryntaa.com in prod, the Vercel preview URL otherwise.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Turnstile site key (CI uses the Cloudflare test sitekey).
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-sitekey"
# Booking embed URL (Cal.com). Absence cleanly disables the booking flow.
NEXT_PUBLIC_BOOKING_URL="https://cal.com/oryntaa"
# Show draft content: 1 on Preview, 0 in Production.
NEXT_PUBLIC_SHOW_DRAFTS="0"
# Manual gate overrides (emergency lever; normally unset). 0 forces off, 1 forces on.
# NEXT_PUBLIC_FLAG_WORK="1"
# NEXT_PUBLIC_FLAG_INSIGHTS="1"
